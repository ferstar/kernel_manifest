+		len--;
+	if (len == 3 && !memcmp(buf, "lz4", 3))
+		id = MEMCOMP_CODEC_LZ4;
+	else if (len == 4 && !memcmp(buf, "zstd", 4))
+		id = MEMCOMP_CODEC_ZSTD;
+	else
