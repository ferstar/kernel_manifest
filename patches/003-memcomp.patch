+			  "raw_candidate_huge_class %llu\n"
+			  "raw_candidate_ge_page %llu\n"
+			  "raw_reject %llu\n"
+			  "raw_reject_huge_class %llu\n"
+			  "raw_reject_ge_page %llu\n"
