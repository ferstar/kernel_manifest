+/*
+ * Include in memcomp.c after its accounting wrappers. Required static hooks:
+ * void memcomp_objcg_get_ref(struct obj_cgroup *); (test-model aware)
+ * void memcomp_objcg_put(struct obj_cgroup *);
+ * int memcomp_objcg_charge(struct obj_cgroup *, gfp_t, size_t);
+ * void memcomp_objcg_uncharge(struct obj_cgroup *, size_t);
+ *
+ * Record allocation/member lifetime, payload, T and L belong to the caller.
+ * reserve failure never consumes record members or resident folio references.
+ * Successful resident refs[] hold initial OWNER ownership. Cache refs[] are
+ * private, not-yet-activated reservations with zero refs; activate infallibly
+ * after accounting, before exposing tokens. They are never lookup guards.
+ * Cache reservation does not allocate a record.
+ * After refs reaches zero, release payload and complete L eligibility removal
+ * before mc16_retire_slot(). A guard is put by the caller without XA relookup.
+ *
+ * Metadata is allocated against the source owner and freed after RCU.
+ */
+#include <linux/err.h>
+#include <linux/atomic.h>
+#include <linux/hashtable.h>
+#include <linux/log2.h>
+#include <linux/memcontrol.h>
+#include <linux/mm.h>
+#include <linux/percpu.h>
+#include <linux/rcupdate.h>
+#include <linux/sched/mm.h>
+#include <linux/slab.h>
+#include <linux/shrinker.h>
+#include <linux/workqueue.h>
+#include <linux/xarray.h>
+
+#include "format.h"
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+#include <kunit/static_stub.h>
+#endif
+
+#define MC16_CLUSTER_SHIFT	9
+#define MC16_CLUSTER_SLOTS	BIT(MC16_CLUSTER_SHIFT)
+#define MC16_SEGMENT_SHIFT	6
+#define MC16_SEGMENT_SLOTS	BIT(MC16_SEGMENT_SHIFT)
+#define MC16_SEGMENTS		(MC16_CLUSTER_SLOTS / MC16_SEGMENT_SLOTS)
+#define MC16_MAX_CLUSTER_ID	(U32_MAX >> MC16_CLUSTER_SHIFT)
+#define MC16_KEY_HASH_BITS	8
+#define MC16_CLUSTER_AGED	BIT(0)
+#define MC16_AGING_BATCH	32
+/* A private non-value marker; never insert it into an XArray. */
+#define MC16_SHADOW_PUBLISHING	2ULL
+
+struct mc16_key;
+
+struct mc16_cluster {
+	struct mc16_slot *segments[MC16_SEGMENTS];
+	struct mc16_key *key;
+	union {
+		struct list_head fifo;
+		struct rcu_head rcu;
+	};
+	u32 id;
+	u32 live_slots;
+	u16 next;
+	u16 wb_cursor;
+	u16 flags;
+	u16 eligible_slots;
+	u64 metadata_bytes;
+	u8 segment_live[MC16_SEGMENTS];
+	u8 reserved[8];
+	u64 *shadows[MC16_SEGMENTS];
+};
+
+enum mc16_key_kind {
+	MC16_KEY_ANON,
+	MC16_KEY_SHMEM,
+};
+
+struct mc16_key {
+	struct hlist_node node;
+	struct obj_cgroup *objcg;
+	struct mc16_cluster *current_cluster;
+	u64 metadata_bytes;
+	u32 clusters;		/* X protected, including queued header callbacks. */
+	u16 nid;
+	unsigned short owner_id;
+	u8 kind;
+	u8 zero_hint;
+};
+
+struct mc16_segment_retire {
+	struct rcu_head rcu;
+	struct mc16_slot *segment;
+	u64 *shadows;
+};
+
+static_assert(sizeof(struct mc16_cluster) == 192);
+static_assert(offsetof(struct mc16_cluster, segments) == 0);
+static_assert(offsetof(struct mc16_cluster, key) == 64);
+static_assert(offsetof(struct mc16_cluster, fifo) == 72);
+static_assert(offsetof(struct mc16_cluster, rcu) == 72);
+static_assert(offsetof(struct mc16_cluster, id) == 88);
+static_assert(offsetof(struct mc16_cluster, live_slots) == 92);
+static_assert(offsetof(struct mc16_cluster, next) == 96);
+static_assert(offsetof(struct mc16_cluster, wb_cursor) == 98);
+static_assert(offsetof(struct mc16_cluster, flags) == 100);
+static_assert(offsetof(struct mc16_cluster, eligible_slots) == 102);
+static_assert(offsetof(struct mc16_cluster, metadata_bytes) == 104);
+static_assert(offsetof(struct mc16_cluster, segment_live) == 112);
+static_assert(offsetof(struct mc16_cluster, reserved) == 120);
+static_assert(offsetof(struct mc16_cluster, shadows) == 128);
+static_assert(sizeof(struct memcomp_ref) == 24);
+static_assert(MC16_SEGMENT_SLOTS * sizeof(struct mc16_slot) == 1024);
+static_assert(MC16_SEGMENT_SLOTS * sizeof(u64) == 512);
+static_assert(!(MC16_SHADOW_PUBLISHING & 1));
+
+enum mc16_storage_class {
+	MC16_META_SEGMENT,
+	MC16_META_CLUSTER,
+	MC16_META_KEY,
+	MC16_META_DESCRIPTOR,
+	MC16_META_SHADOW,
+	MC16_META_CLASSES,
+};
+
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+struct mc16_storage_debug {
+	u64 allocated[MC16_META_CLASSES];
+	u64 freed[MC16_META_CLASSES];
+	u64 allocated_bytes[MC16_META_CLASSES];
+	u64 freed_bytes[MC16_META_CLASSES];
+	u64 descriptor_failures;
+	u64 meta_count_calls;
+	u64 meta_scan_calls;
+	u64 meta_detached;
+	u64 aging_work_calls;
+	u64 aging_detached;
+};
+
+static DEFINE_PER_CPU(struct mc16_storage_debug, mc16_storage_debug);
+#endif
+
+static inline void mc16_meta_alloc(enum mc16_storage_class type, void *ptr)
+{
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_inc(mc16_storage_debug.allocated[type]);
+	this_cpu_add(mc16_storage_debug.allocated_bytes[type], ksize(ptr));
+#endif
+}
+
+static inline void mc16_meta_free(enum mc16_storage_class type, void *ptr)
+{
+	if (!ptr)
+		return;
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_inc(mc16_storage_debug.freed[type]);
+	this_cpu_add(mc16_storage_debug.freed_bytes[type], ksize(ptr));
+#endif
+	kfree(ptr);
+}
+
+static DEFINE_XARRAY_FLAGS(mc16_clusters,
+			   XA_FLAGS_ALLOC1 | XA_FLAGS_LOCK_IRQ);
+static DEFINE_HASHTABLE(mc16_keys, MC16_KEY_HASH_BITS);
+static unsigned long mc16_retained_empty_headers;
+static unsigned long mc16_meta_shrinker_cursor = 1;
+static void mc16_retained_age_work(struct work_struct *work);
+static DECLARE_DEFERRABLE_WORK(mc16_retained_aging, mc16_retained_age_work);
+
+/* X protects the numeric sweep state; no iterator survives an unlock. */
+static struct {
+	unsigned long next_id;
+	unsigned long not_before;
+	bool active;
+	bool deadline_valid;
+	bool requested;
+} mc16_aging = { .next_id = 1 };
+
+static unsigned long mc16_aging_now(void)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_aging_now);
+#endif
+	return jiffies;
+}
+
+static void mc16_queue_aging(unsigned long delay)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_queue_aging, delay);
+#endif
+	mod_delayed_work(system_unbound_wq, &mc16_retained_aging, delay);
+}
+
+static void mc16_schedule_aging(void)
+{
+	unsigned long irqflags, now, delay;
+
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_schedule_aging);
+#endif
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	if (mc16_aging.requested) {
+		xa_unlock_irqrestore(&mc16_clusters, irqflags);
+		return;
+	}
+	now = mc16_aging_now();
+	mc16_aging.requested = true;
+	if (!mc16_aging.deadline_valid) {
+		mc16_aging.not_before = now + HZ;
+		mc16_aging.deadline_valid = true;
+	}
+	delay = !mc16_aging.active &&
+		time_before(now, mc16_aging.not_before) ?
+		mc16_aging.not_before - now : 0;
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+	/* An early concurrent kick cannot bypass the callback's deadline. */
+	mc16_queue_aging(delay);
+}
+
+static inline bool mc16_retained_empty_inc_locked(void)
+{
+	unsigned long count;
+
+	lockdep_assert_held(&mc16_clusters.xa_lock);
+	count = READ_ONCE(mc16_retained_empty_headers);
+	WRITE_ONCE(mc16_retained_empty_headers, count + 1);
+	return !count;
+}
+
+static inline void mc16_retained_empty_dec_locked(void)
+{
+	unsigned long count;
+
+	lockdep_assert_held(&mc16_clusters.xa_lock);
+	count = READ_ONCE(mc16_retained_empty_headers);
+	if (WARN_ON_ONCE(!count))
+		return;
+	WRITE_ONCE(mc16_retained_empty_headers, count - 1);
+}
+
+/* A real source objcg reference is held by record/caller/key in this scope. */
+static inline void *mc16_kmalloc_owner(size_t bytes, gfp_t gfp,
+				       struct obj_cgroup *objcg)
+{
+	struct mem_cgroup *memcg = NULL, *old;
+	void *ptr;
+
+#ifdef CONFIG_MEMCG
+	if (objcg)
+		memcg = get_mem_cgroup_from_objcg(objcg);
+#endif
+	old = set_active_memcg(memcg);
+	/* An unaccounted/root source must not charge the submitting task. */
+	if (objcg)
+		gfp |= __GFP_ACCOUNT;
+	else
+		gfp &= ~__GFP_ACCOUNT;
+	ptr = kmalloc(bytes, gfp);
+	set_active_memcg(old);
+#ifdef CONFIG_MEMCG
+	if (memcg)
+		css_put(&memcg->css);
+#endif
+	return ptr;
+}
+
+static inline void *mc16_owner_alloc(size_t bytes, gfp_t gfp,
+				     struct obj_cgroup *objcg)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	return mc16_kunit_storage_alloc(bytes, gfp, objcg);
+#else
+	return mc16_kmalloc_owner(bytes, gfp, objcg);
+#endif
+}
+
+static inline void mc16_queue_rcu(struct rcu_head *head, rcu_callback_t func)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	mc16_kunit_queue_rcu(head, func);
+#else
+	call_rcu(head, func);
+#endif
+}
+
+static inline void *mc16_alloc_zero(enum mc16_storage_class type,
+				    size_t bytes, struct obj_cgroup *objcg)
+{
+	void *ptr;
+
+	ptr = mc16_owner_alloc(bytes, GFP_NOIO | __GFP_NOWARN, objcg);
+	if (ptr) {
+		memset(ptr, 0, bytes);
+		mc16_meta_alloc(type, ptr);
+	}
+	return ptr;
+}
+
+/*
+ * A request owns a temporary source ID reference across X1/X2. Each key takes
+ * another reference, independent of objcg reparenting and the request lifetime.
+ */
+static inline int mc16_source_id_get(struct folio *folio, unsigned short *id)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_source_id_get, folio, id);
+#endif
+	return mem_cgroup_memcomp_id_get_checked(folio, id);
+}
+
+static inline bool mc16_owner_id_get_ref(unsigned short id)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_owner_id_get_ref, id);
+#endif
+	return mem_cgroup_memcomp_id_get_ref(id);
+}
+
+static inline void mc16_owner_id_put(unsigned short id)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_owner_id_put, id);
+#endif
+	mem_cgroup_memcomp_id_put(id);
+}
+
+/* Caller holds mc16_clusters.xa_lock for every key/current operation. */
+static inline unsigned long
+mc16_key_tag_id(struct obj_cgroup *objcg, unsigned int nid, u8 kind,
+		bool zero_hint, unsigned short owner_id)
+{
+	return (unsigned long)objcg ^ ((unsigned long)nid << 1) ^ kind ^
+		((unsigned long)zero_hint << 3) ^ ((unsigned long)owner_id << 4);
+}
+
+static inline unsigned long mc16_key_tag(struct obj_cgroup *objcg,
+					 unsigned int nid, u8 kind,
+					 bool zero_hint)
+{
+	return mc16_key_tag_id(objcg, nid, kind, zero_hint, 0);
+}
+
+static inline struct mc16_key *
+mc16_key_find_id(struct obj_cgroup *objcg, unsigned int nid, u8 kind,
+		 bool zero_hint, unsigned short owner_id)
+{
+	struct mc16_key *key;
+	unsigned long tag = mc16_key_tag_id(objcg, nid, kind, zero_hint, owner_id);
+
+	lockdep_assert_held(&mc16_clusters.xa_lock);
+	hash_for_each_possible(mc16_keys, key, node, tag) {
+		if (key->objcg == objcg && key->nid == nid && key->kind == kind &&
+		    key->zero_hint == zero_hint && key->owner_id == owner_id)
+			return key;
+	}
+	return NULL;
+}
+
+static inline int mc16_private_id_alloc(u32 *id)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_private_id_alloc, id);
+#endif
+	return __xa_alloc(&mc16_clusters, id, NULL,
+			  XA_LIMIT(1, MC16_MAX_CLUSTER_ID),
+			  GFP_NOWAIT | __GFP_NOWARN);
+}
+
+static inline struct mc16_key *mc16_key_zalloc(void)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_key_zalloc);
+#endif
+	return kzalloc(sizeof(struct mc16_key), GFP_NOIO | __GFP_NOWARN);
+}
+
+/* Key slab is manually charged, with one independent test-aware objcg hold. */
+static inline struct mc16_key *
+mc16_key_alloc_id(struct obj_cgroup *objcg, unsigned int nid, u8 kind,
+		  bool zero_hint, unsigned short owner_id)
+{
+	struct mc16_key *key;
+	int ret;
+
+	key = mc16_key_zalloc();
+	if (!key)
+		return ERR_PTR(-ENOMEM);
+	mc16_meta_alloc(MC16_META_KEY, key);
+	key->metadata_bytes = ksize(key);
+	if (!mc16_owner_id_get_ref(owner_id)) {
+		mc16_meta_free(MC16_META_KEY, key);
+		return ERR_PTR(-ENOENT);
+	}
+	key->owner_id = owner_id;
+	if (objcg) {
+		ret = memcomp_objcg_charge(objcg, GFP_NOIO | __GFP_NOWARN,
+					   key->metadata_bytes);
+		if (ret) {
+			mc16_owner_id_put(owner_id);
+			mc16_meta_free(MC16_META_KEY, key);
+			return ERR_PTR(ret);
+		}
+		memcomp_objcg_get_ref(objcg);
+	}
+	key->objcg = objcg;
+	key->nid = nid;
+	key->kind = kind;
+	key->zero_hint = zero_hint;
+	return key;
+}
+
+/* Legacy storage fixtures use an unrecorded ID, not root's real ID. */
+static inline struct mc16_key *
+mc16_key_alloc(struct obj_cgroup *objcg, unsigned int nid, u8 kind,
+	       bool zero_hint)
+{
+	return mc16_key_alloc_id(objcg, nid, kind, zero_hint, 0);
+}
+
+static inline void mc16_key_free(struct mc16_key *key)
+{
+	struct obj_cgroup *objcg;
+
+	if (!key)
+		return;
+	objcg = key->objcg;
+	if (objcg) {
+		memcomp_objcg_uncharge(objcg, key->metadata_bytes);
+		memcomp_objcg_put(objcg);
+	}
+	mc16_owner_id_put(key->owner_id);
+	mc16_meta_free(MC16_META_KEY, key);
+}
+
+static inline bool mc16_get(unsigned long token, struct memcomp_ref *out)
+{
+	struct mc16_cluster *cluster;
+	struct mc16_slot *segment, *slot;
+	unsigned int index, id;
+	bool found = false;
+
+	if (!out)
+		return false;
+	*out = (struct memcomp_ref) { };
+	if (!token || token > U32_MAX)
+		return false;
+	id = token >> MC16_CLUSTER_SHIFT;
+	index = token & (MC16_CLUSTER_SLOTS - 1);
+	if (!id)
+		return false;
+
+	rcu_read_lock();
+	cluster = xa_load(&mc16_clusters, id);
+	if (!cluster)
+		goto out;
+	/* Pair with release-next: all slots and alignment holes are initialized. */
+	if (index >= smp_load_acquire(&cluster->next))
+		goto out;
+	/* Pair with segment install; RCU protects a concurrently detached one. */
+	segment = smp_load_acquire(&cluster->segments[index >> MC16_SEGMENT_SHIFT]);
+	if (!segment)
+		goto out;
+	slot = &segment[index & (MC16_SEGMENT_SLOTS - 1)];
+	if (!refcount_inc_not_zero(&slot->refs))
+		goto out;
+	out->slot = slot;
+	out->cluster = cluster;
+	out->token = token;
+	found = true;
+out:
+	rcu_read_unlock();
+	return found;
+}
+
+/*
+ * A guard (or an unpublished reservation) pins both arrays. Only T permits
+ * reading/writing the returned word; it must not escape that critical section.
+ */
+static inline u64 *mc16_shadow_ptr(const struct memcomp_ref *ref)
+{
+	unsigned int index, seg;
+
+	if (WARN_ON_ONCE(!ref || !ref->slot || !ref->cluster))
+		return NULL;
+	lockdep_assert_held(memcomp_lock_of(ref->token));
+	index = ref->token & (MC16_CLUSTER_SLOTS - 1);
+	seg = index >> MC16_SEGMENT_SHIFT;
+	if (WARN_ON_ONCE(!ref->cluster->shadows[seg]))
+		return NULL;
+	return &ref->cluster->shadows[seg][index & (MC16_SEGMENT_SLOTS - 1)];
+}
+
+/* The key identity is immutable and survives every held guard. */
+static inline unsigned short mc16_owner_id(const struct memcomp_ref *ref)
+{
+	return ref->cluster->key->owner_id;
+}
+
+static inline void mc16_segment_rcu_free(struct rcu_head *rcu)
+{
+	struct mc16_segment_retire *retired;
+
+	retired = container_of(rcu, struct mc16_segment_retire, rcu);
+	mc16_meta_free(MC16_META_SEGMENT, retired->segment);
+	mc16_meta_free(MC16_META_SHADOW, retired->shadows);
+	mc16_meta_free(MC16_META_DESCRIPTOR, retired);
+}
+
+static inline void mc16_cluster_rcu_free(struct rcu_head *rcu)
+{
+	struct mc16_cluster *cluster;
+	struct mc16_key *key, *last = NULL;
+	unsigned int i;
+	unsigned long irqflags;
+
+	cluster = container_of(rcu, struct mc16_cluster, rcu);
+	key = cluster->key;
+	for (i = 0; i < MC16_SEGMENTS; i++) {
+		mc16_meta_free(MC16_META_SEGMENT, cluster->segments[i]);
+		mc16_meta_free(MC16_META_SHADOW, cluster->shadows[i]);
+	}
+	mc16_meta_free(MC16_META_CLUSTER, cluster);
+
+	/* A queued header still owns its key until this exact transaction. */
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	if (WARN_ON_ONCE(!key->clusters)) {
+		xa_unlock_irqrestore(&mc16_clusters, irqflags);
+		return;
+	}
+	if (!--key->clusters) {
+		WARN_ON_ONCE(key->current_cluster);
+		hash_del(&key->node);
+		last = key;
+	}
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+	mc16_key_free(last);
+}
+
+/* A detached header owns its key until mc16_cluster_rcu_free(). */
+static inline void mc16_queue_cluster(struct mc16_cluster *cluster)
+{
+	mc16_queue_rcu(&cluster->rcu, mc16_cluster_rcu_free);
+}
+
+/* Return -1 to stop, zero to continue, or the next full-pass delay. */
+static long mc16_aging_step_locked(unsigned long now,
+				   struct mc16_cluster **detached, unsigned int *nr_detached,
+				   unsigned int *checked)
+{
+	bool complete = false;
+
+	lockdep_assert_held(&mc16_clusters.xa_lock);
+	*nr_detached = 0;
+	*checked = 0;
+	mc16_aging.requested = false;
+	if (!READ_ONCE(mc16_retained_empty_headers)) {
+		mc16_aging.active = false;
+		mc16_aging.next_id = 1;
+		return -1;
+	}
+	if (!mc16_aging.active && mc16_aging.deadline_valid &&
+	    time_before(now, mc16_aging.not_before))
+		return mc16_aging.not_before - now;
+	mc16_aging.active = true;
+
+	while (*checked < MC16_AGING_BATCH) {
+		XA_STATE(xas, &mc16_clusters, mc16_aging.next_id);
+		struct mc16_cluster *cluster;
+		unsigned long id;
+		void *entry;
+
+		/* Raw lookup exposes private reservations hidden by xa_find(). */
+		entry = xas_find(&xas, MC16_MAX_CLUSTER_ID);
+		if (!entry) {
+			complete = true;
+			break;
+		}
+		(*checked)++;
+		id = xas.xa_index;
+		if (id == MC16_MAX_CLUSTER_ID)
+			complete = true;
+		else
+			mc16_aging.next_id = id + 1;
+		if (xa_is_value(entry) || xa_is_internal(entry))
+			goto next;
+		cluster = entry;
+		if (cluster->id != id ||
+		    cluster->key->current_cluster != cluster ||
+		    cluster->live_slots || !cluster->next ||
+		    cluster->next >= MC16_CLUSTER_SLOTS ||
+		    cluster->eligible_slots || !list_empty(&cluster->fifo))
+			goto next;
+		if (!(cluster->flags & MC16_CLUSTER_AGED)) {
+			cluster->flags |= MC16_CLUSTER_AGED;
+			goto next;
+		}
+		mc16_retained_empty_dec_locked();
+		cluster->key->current_cluster = NULL;
+		__xa_erase(&mc16_clusters, cluster->id);
+		detached[(*nr_detached)++] = cluster;
+next:
+		/* Rebuild XA_STATE before the next lookup, including after erase. */
+		if (complete)
+			break;
+	}
+	if (complete) {
+		mc16_aging.next_id = 1;
+		mc16_aging.active = false;
+		mc16_aging.not_before = mc16_aging_now() + HZ;
+		mc16_aging.deadline_valid = true;
+	}
+	if (!READ_ONCE(mc16_retained_empty_headers)) {
+		mc16_aging.next_id = 1;
+		mc16_aging.active = false;
+		return -1;
+	}
+	return mc16_aging.active ? 0 : HZ;
+}
+
+/* Detached headers retain their keys until the existing RCU callback. */
+static void mc16_retained_age_work(struct work_struct *work)
+{
+	struct mc16_cluster *detached[MC16_AGING_BATCH];
+	unsigned long irqflags;
+	unsigned int checked, nr_detached, i;
+	long delay;
+
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_inc(mc16_storage_debug.aging_work_calls);
+#endif
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	delay = mc16_aging_step_locked(mc16_aging_now(), detached,
+				       &nr_detached, &checked);
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+
+	for (i = 0; i < nr_detached; i++) {
+		mc16_queue_cluster(detached[i]);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+		this_cpu_inc(mc16_storage_debug.aging_detached);
+#endif
+	}
+	if (delay >= 0)
+		mc16_queue_aging(delay);
+}
+
+static unsigned long mc16_meta_shrinker_count(struct shrinker *shrinker,
+					      struct shrink_control *sc)
+{
+	unsigned long count = READ_ONCE(mc16_retained_empty_headers);
+
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_inc(mc16_storage_debug.meta_count_calls);
+#endif
+	return count ? count : SHRINK_EMPTY;
+}
+
+static unsigned long mc16_meta_shrinker_scan(struct shrinker *shrinker,
+					     struct shrink_control *sc)
+{
+	struct mc16_cluster *detached[64];
+	unsigned long irqflags, start, id, max = MC16_MAX_CLUSTER_ID;
+	unsigned long limit = min_t(unsigned long, sc->nr_to_scan,
+				    ARRAY_SIZE(detached));
+	unsigned int checked = 0, nr_detached = 0, i;
+	bool wrapped = false;
+
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_inc(mc16_storage_debug.meta_scan_calls);
+#endif
+	sc->nr_scanned = 0;
+	if (!limit)
+		return 0;
+
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	start = mc16_meta_shrinker_cursor;
+	id = start;
+	while (checked < limit) {
+		struct mc16_cluster *cluster;
+
+		/* The normal API skips private zero entries as well as holes. */
+		cluster = xa_find(&mc16_clusters, &id, max, XA_PRESENT);
+		if (!cluster) {
+			if (wrapped || start == 1) {
+				id = 1;
+				break;
+			}
+			/* The disjoint second range cannot revisit an entry. */
+			id = 1;
+			max = start - 1;
+			wrapped = true;
+			continue;
+		}
+		if (xa_is_value(cluster) || xa_is_internal(cluster)) {
+			id++;
+			continue;
+		}
+		checked++;
+		if (cluster->id == id &&
+		    cluster->key->current_cluster == cluster &&
+		    !cluster->live_slots && cluster->next &&
+		    cluster->next < MC16_CLUSTER_SLOTS &&
+		    !cluster->eligible_slots && list_empty(&cluster->fifo)) {
+			mc16_retained_empty_dec_locked();
+			cluster->key->current_cluster = NULL;
+			__xa_erase(&mc16_clusters, id);
+			detached[nr_detached++] = cluster;
+		}
+		id++;
+	}
+	mc16_meta_shrinker_cursor = id > MC16_MAX_CLUSTER_ID ? 1 : id;
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+	sc->nr_scanned = checked;
+
+	for (i = 0; i < nr_detached; i++)
+		mc16_queue_cluster(detached[i]);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_add(mc16_storage_debug.meta_detached, nr_detached);
+#endif
+	/* do_shrink_slab() repeats a pass that scanned nothing until it stops. */
+	return checked ? nr_detached : SHRINK_STOP;
+}
+
+/* refs is already zero; no caller may use slot/cluster after this function. */
+static inline void mc16_retire_slot(struct memcomp_ref *ref)
+{
+	struct mc16_segment_retire *retired = NULL;
+	struct mc16_cluster *cluster, *last = NULL;
+	bool schedule_aging = false;
+	struct mc16_slot *segment;
+	unsigned int seg;
+	unsigned long irqflags;
+
+	if (WARN_ON_ONCE(!ref || !ref->slot || !ref->cluster))
+		return;
+	cluster = ref->cluster;
+	seg = (ref->token & (MC16_CLUSTER_SLOTS - 1)) >> MC16_SEGMENT_SHIFT;
+	if (WARN_ON_ONCE(refcount_read(&ref->slot->refs)))
+		return;
+
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	if (WARN_ON_ONCE(!cluster->live_slots || !cluster->segment_live[seg]) ||
+	    WARN_ON_ONCE(cluster->live_slots == 1 && cluster->eligible_slots)) {
+		xa_unlock_irqrestore(&mc16_clusters, irqflags);
+		return;
+	}
+	cluster->live_slots--;
+	cluster->segment_live[seg]--;
+	segment = cluster->segments[seg];
+	if (!cluster->segment_live[seg] &&
+	    cluster->next >= (seg + 1) * MC16_SEGMENT_SLOTS) {
+		retired = mc16_owner_alloc(sizeof(*retired),
+					   GFP_NOWAIT | __GFP_NOWARN, cluster->key->objcg);
+		if (retired) {
+			mc16_meta_alloc(MC16_META_DESCRIPTOR, retired);
+			retired->segment = segment;
+			retired->shadows = cluster->shadows[seg];
+			/* Old RCU readers retain permanently zero refs until grace. */
+			smp_store_release(&cluster->segments[seg], NULL);
+			cluster->shadows[seg] = NULL;
+		} else {
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+			this_cpu_inc(mc16_storage_debug.descriptor_failures);
+#endif
+		}
+	}
+	if (!cluster->live_slots) {
+		WARN_ON_ONCE(!list_empty(&cluster->fifo));
+		if (cluster->key->current_cluster == cluster &&
+		    cluster->next < MC16_CLUSTER_SLOTS) {
+			schedule_aging = mc16_retained_empty_inc_locked();
+		} else {
+			if (cluster->key->current_cluster == cluster)
+				cluster->key->current_cluster = NULL;
+			__xa_erase(&mc16_clusters, cluster->id);
+			last = cluster;
+		}
+	}
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+	/* Non-winners never dereference cluster or slot after releasing X. */
+	*ref = (struct memcomp_ref) { };
+	if (schedule_aging)
+		mc16_schedule_aging();
+	if (retired)
+		mc16_queue_rcu(&retired->rcu, mc16_segment_rcu_free);
+	if (last)
+		mc16_queue_rcu(&last->rcu, mc16_cluster_rcu_free);
+}
+
+/* Under X, return an aligned range wholly inside one segment/cluster. */
+static inline bool mc16_range(struct mc16_cluster *cluster, unsigned int nr,
+			      unsigned int *index)
+{
+	unsigned int start;
+
+	if (!cluster)
+		return false;
+	start = ALIGN(cluster->next, nr);
+	if (start + nr > MC16_CLUSTER_SLOTS)
+		return false;
+	*index = start;
+	return true;
+}
+
+/* Independent of the later payload/T helpers; bytes zero means SAMEFILL. */
+struct mc16_initial_payload {
+	u64 word;
+	u32 bytes;
+};
+
+/* Stack-only identity; record or caller keeps objcg alive across X1/X2. */
+struct mc16_reserve_request {
+	struct mc16_record *record;
+	const struct mc16_initial_payload *payloads;
+	struct obj_cgroup *objcg;
+	unsigned int nid;
+	unsigned int nr;
+	unsigned short owner_id;
+	u8 kind;
+	bool zero_hint;
+};
+
+/* Infallible commit: all input validation and allocation precedes this. */
+static inline void
+mc16_publish_slots(struct mc16_cluster *cluster,
+		   const struct mc16_reserve_request *request,
+		   unsigned int index, struct memcomp_ref refs[])
+{
+	struct mc16_slot *segment = cluster->segments[index >> MC16_SEGMENT_SHIFT];
+	struct mc16_record *record = request->record;
+	unsigned int i, nr = request->nr, order = ilog2(nr);
+	u32 base = (cluster->id << MC16_CLUSTER_SHIFT) | index;
+
+	cluster->flags &= ~MC16_CLUSTER_AGED;
+	if (record)
+		record->token_base = base;
+	for (i = 0; i < nr; i++) {
+		struct mc16_slot *slot;
+		u16 flags = order << MC16_ORDER_SHIFT;
+
+		slot = &segment[(index + i) & (MC16_SEGMENT_SLOTS - 1)];
+		if (record) {
+			folio_get(record->producer);
+			slot->word = (u64)(unsigned long)record;
+			slot->length = 0;
+			flags |= MC16_PENDING | MC16_F_OWNER | MC16_F_RESIDENT;
+		} else {
+			const struct mc16_initial_payload *initial;
+
+			initial = &request->payloads[i];
+			slot->word = initial->word;
+			slot->length = initial->bytes ? initial->bytes - 1 : 0;
+			flags |= initial->bytes ? MC16_STORED : MC16_SAMEFILL;
+		}
+		/* Cache initialization completes only after caller accounting. */
+		refcount_set(&slot->refs, record ? 1 : 0);
+		/* Stable SAMEFILL readers acquire flags before reading word. */
+		smp_store_release(&slot->flags, flags);
+		refs[i] = (struct memcomp_ref) {
+			.slot = slot, .cluster = cluster, .token = base + i,
+		};
+	}
+	cluster->live_slots += nr;
+	cluster->segment_live[index >> MC16_SEGMENT_SHIFT] += nr;
+	/* Includes permanently zero, never-reused alignment holes. */
+	smp_store_release(&cluster->next, index + nr);
+}
+
+/*
+ * P0: one X. P1: X1 preflight, source-owned allocation, X2 commit/cancel.
+ * No A/T/L, no reserve-local retry, no third X, no record-member put here.
+ * Validated request identity is independently owned across both sections.
+ */
+static inline int
+mc16_reserve_request(const struct mc16_reserve_request *request,
+		     struct memcomp_ref refs[])
+{
+	struct mc16_cluster *cluster = NULL, *spare_cluster = NULL;
+	struct mc16_cluster *replaced = NULL;
+	struct mc16_slot *spare_segment = NULL;
+	u64 *spare_shadows = NULL;
+	struct mc16_key *key, *spare_key = NULL;
+	struct obj_cgroup *objcg = request->objcg;
+	unsigned int nr = request->nr, nid = request->nid;
+	unsigned int index = 0, target_next = 0, target_id = 0, seg;
+	u32 private_id = 0;
+	unsigned long irqflags;
+	bool new_cluster, new_key, reserved = false;
+	u8 kind = request->kind;
+	unsigned short owner_id = request->owner_id;
+	int ret = 0;
+	void *old;
+
+	memset(refs, 0, sizeof(*refs) * nr);
+
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	key = mc16_key_find_id(objcg, nid, kind, request->zero_hint,
+			       owner_id);
+	cluster = key ? key->current_cluster : NULL;
+	if (mc16_range(cluster, nr, &index)) {
+		seg = index >> MC16_SEGMENT_SHIFT;
+		if (cluster->segments[seg]) {
+			if (!cluster->live_slots && cluster->next)
+				mc16_retained_empty_dec_locked();
+			mc16_publish_slots(cluster, request, index, refs);
+			xa_unlock_irqrestore(&mc16_clusters, irqflags);
+			return 0;
+		}
+		new_cluster = false;
+		target_id = cluster->id;
+		target_next = cluster->next;
+	} else {
+		new_cluster = true;
+		/* NULL is converted internally to a private reserved marker. */
+		ret = mc16_private_id_alloc(&private_id);
+		if (ret) {
+			xa_unlock_irqrestore(&mc16_clusters, irqflags);
+			return ret;
+		}
+		reserved = true;
+		if (cluster) {
+			target_id = cluster->id;
+			target_next = cluster->next;
+		}
+	}
+	new_key = !key;
+	/* Carry only scalar geometry and independently owned source identity. */
+	cluster = NULL;
+	key = NULL;
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+
+	spare_segment = mc16_alloc_zero(MC16_META_SEGMENT,
+					MC16_SEGMENT_SLOTS * sizeof(*spare_segment), objcg);
+	if (!spare_segment) {
+		ret = -ENOMEM;
+		goto recheck;
+	}
+	spare_shadows = mc16_alloc_zero(MC16_META_SHADOW,
+					MC16_SEGMENT_SLOTS * sizeof(*spare_shadows), objcg);
+	if (!spare_shadows) {
+		ret = -ENOMEM;
+		goto recheck;
+	}
+	if (new_cluster) {
+		spare_cluster = mc16_alloc_zero(MC16_META_CLUSTER,
+						sizeof(*spare_cluster), objcg);
+		if (!spare_cluster) {
+			ret = -ENOMEM;
+			goto recheck;
+		}
+		spare_cluster->metadata_bytes = ksize(spare_cluster);
+		INIT_LIST_HEAD(&spare_cluster->fifo);
+	}
+	if (new_key) {
+		spare_key = mc16_key_alloc_id(objcg, nid, kind,
+					      request->zero_hint, owner_id);
+		if (IS_ERR(spare_key)) {
+			ret = PTR_ERR(spare_key);
+			spare_key = NULL;
+		}
+	}
+recheck:
+	xa_lock_irqsave(&mc16_clusters, irqflags);
+	if (ret)
+		goto cancel;
+	key = mc16_key_find_id(objcg, nid, kind, request->zero_hint,
+			       owner_id);
+	cluster = key ? key->current_cluster : NULL;
+	/* Reject competing consumption/retirement without another allocation. */
+	if ((cluster ? cluster->id : 0) != target_id ||
+	    (cluster && cluster->next != target_next)) {
+		ret = -EAGAIN;
+		goto cancel;
+	}
+	if (!new_cluster) {
+		if (!key || !mc16_range(cluster, nr, &index) ||
+		    cluster->segments[index >> MC16_SEGMENT_SHIFT]) {
+			ret = -EAGAIN;
+			goto cancel;
+		}
+	} else {
+		if (!key && !spare_key) {
+			ret = -EAGAIN;
+			goto cancel;
+		}
+		if (!key)
+			key = spare_key;
+		replaced = cluster && !cluster->live_slots ? cluster : NULL;
+		cluster = spare_cluster;
+		cluster->id = private_id;
+		cluster->key = key;
+		old = __xa_store(&mc16_clusters, private_id, cluster,
+				 GFP_NOWAIT | __GFP_NOWARN);
+		if (WARN_ON_ONCE(xa_is_err(old))) {
+			ret = xa_err(old);
+			replaced = NULL;
+			goto cancel;
+		}
+		WARN_ON_ONCE(old);
+		reserved = false;
+		spare_cluster = NULL;
+		if (key == spare_key) {
+			hash_add(mc16_keys, &key->node,
+				 mc16_key_tag_id(objcg, nid, kind,
+						 request->zero_hint, owner_id));
+			spare_key = NULL;
+		}
+		key->clusters++;
+		if (replaced) {
+			mc16_retained_empty_dec_locked();
+			__xa_erase(&mc16_clusters, replaced->id);
+		}
+		key->current_cluster = cluster;
+		index = 0;
+	}
+	seg = index >> MC16_SEGMENT_SHIFT;
+	/* Publish the zeroed shadow array before either lookup publication. */
+	cluster->shadows[seg] = spare_shadows;
+	spare_shadows = NULL;
+	/* Pair with lookup acquire; only new, zeroed storage is installed. */
+	smp_store_release(&cluster->segments[seg], spare_segment);
+	spare_segment = NULL;
+	if (!new_cluster && !cluster->live_slots && cluster->next)
+		mc16_retained_empty_dec_locked();
+	mc16_publish_slots(cluster, request, index, refs);
+cancel:
+	if (reserved)
+		__xa_erase(&mc16_clusters, private_id);
+	xa_unlock_irqrestore(&mc16_clusters, irqflags);
+	/* Unpublished resources only; source/payload ownership stays with caller. */
+	mc16_meta_free(MC16_META_SEGMENT, spare_segment);
+	mc16_meta_free(MC16_META_SHADOW, spare_shadows);
+	mc16_meta_free(MC16_META_CLUSTER, spare_cluster);
+	mc16_key_free(spare_key);
+	if (replaced)
+		mc16_queue_cluster(replaced);
+	return ret;
+}
+
+/* Existing resident reserve API and its record/member ownership are unchanged. */
+static inline int mc16_reserve_hint(struct mc16_record *record, unsigned int nr,
+				    u8 kind, bool zero_hint,
+				    struct memcomp_ref refs[])
+{
+	struct mc16_reserve_request request;
+	unsigned short owner_id;
+	int ret;
+
+	if (!record || !refs || !record->producer || !nr ||
+	    nr > MC16_MAX_PAGES || !is_power_of_2(nr) ||
+	    record->nr_pages != nr ||
+	    kind != !!(record->record_flags & MC16_RECORD_SHMEM))
+		return -EINVAL;
+	ret = mc16_source_id_get(record->producer, &owner_id);
+	if (ret)
+		return ret;
+	request = (struct mc16_reserve_request) {
+		.record = record, .objcg = record->objcg, .owner_id = owner_id,
+		.nid = record->nid, .nr = nr, .kind = kind,
+		.zero_hint = zero_hint,
+	};
+	ret = mc16_reserve_request(&request, refs);
+	mem_cgroup_memcomp_id_put(owner_id);
+	return ret;
+}
+
+static inline int mc16_reserve(struct mc16_record *record, unsigned int nr,
+			       u8 kind, struct memcomp_ref refs[])
+{
+	return mc16_reserve_hint(record, nr, kind, false, refs);
+}
+
+/*
+ * Direct SHMEM cache ownership: no record, resident folio hold or lookup ref.
+ * Caller holds objcg (NULL for root), zs handles and exact bytes charges before
+ * entry, keeps objcg and owner_id alive until return, and keeps payloads immutable.
+ * The ID is borrowed; a new key takes its own reference. ID 0 needs no hold.
+ * Validate the entire span before X1: no error may follow partial publication.
+ * bytes == 0 is a full-width SAMEFILL word; otherwise word is a nonzero zs handle.
+ * Success transfers payload/charge ownership to stable slots, backed by the key's
+ * independent objcg hold. The source array is unchanged: caller must not abort it.
+ * Failure consumes nothing. refs[] is untouched on invalid input, zeroed after
+ * valid input reaches reserve. Caller must finish stats and infallible first
+ * activation before exposing tokens. Until then live_slots protects storage,
+ * but refs stay zero so FIFO/lookup cannot acquire a guard. Never get/put this
+ * private reservation or confuse its initial zero with a retired index.
+ */
+static inline int
+mc16_reserve_cache_id(struct obj_cgroup *objcg, unsigned short owner_id,
+		      unsigned int nid,
+		      const struct mc16_initial_payload payloads[],
+		      unsigned int nr, struct memcomp_ref refs[])
+{
+	struct mc16_reserve_request request;
+	unsigned int i, order, state;
+	u16 length, flags;
+
+	/* Check wide inputs before any narrowing, array access or output clearing. */
+	if (!payloads || !refs || nid > U16_MAX || nid >= MAX_NUMNODES ||
+	    !nr || nr > MC16_MAX_PAGES || !is_power_of_2(nr))
+		return -EINVAL;
+	order = ilog2(nr);
+	for (i = 0; i < nr; i++) {
+		state = payloads[i].bytes ? MC16_STORED : MC16_SAMEFILL;
+		if ((payloads[i].bytes && !payloads[i].word) ||
+		    !mc16_payload_length_encode(state, payloads[i].bytes, &length) ||
+		    !mc16_flags_encode(state, order, 0, &flags))
+			return -EINVAL;
+	}
+	request = (struct mc16_reserve_request) {
+		.payloads = payloads, .objcg = objcg, .owner_id = owner_id,
+		.nid = nid, .nr = nr, .kind = MC16_KEY_SHMEM,
+		.zero_hint = false,
+	};
+	return mc16_reserve_request(&request, refs);
+}
+
+/*
+ * Compatibility for storage-only fixtures. Production cache callers pass a
+ * source-folio ID via mc16_reserve_cache_id(), held until reserve returns.
+ */
+static inline int
+mc16_reserve_cache(struct obj_cgroup *objcg, unsigned int nid,
+		   const struct mc16_initial_payload payloads[],
+		   unsigned int nr, struct memcomp_ref refs[])
+{
+	return mc16_reserve_cache_id(objcg, 0, nid, payloads, nr, refs);
+}
+
+#endif /* _MM_MEMCOMP_STORAGE_H */
diff --git a/mm/memcomp/swapoff.h b/mm/memcomp/swapoff.h
new file mode 100644
index 000000000..9ddee36a9
--- /dev/null
+++ b/mm/memcomp/swapoff.h
@@ -0,0 +1,190 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_SWAPOFF_H
+#define _MM_MEMCOMP_SWAPOFF_H
+#ifdef CONFIG_SWAP
+
+struct mc16_swapoff_tail {
+	swp_entry_t swap;
+	u32 old_bytes;
+	u32 new_bytes;
+};
+
+/*
+ * The caller holds a slot guard throughout preparation, commit and the tail.
+ * No record pointer escapes T. The new payload stays caller-owned on failure.
+ * expected_word/length identify the complete old encoded backing snapshot.
+ */
+static inline int
+mc16_swapoff_commit(struct memcomp_ref *ref, u64 expected_word,
+		    u16 expected_length, struct mc16_payload *payload,
+		    gfp_t gfp, struct mc16_swapoff_tail *tail)
+{
+	struct obj_cgroup *objcg = ref->cluster->key->objcg;
+	struct mc16_swap_fields old;
+	struct mc16_view view;
+	unsigned int state;
+	u32 charged = 0;
+	u16 length;
+	int ret = 0;
+
+	state = payload->bytes ? MC16_STORED : MC16_SAMEFILL;
+	if (payload->charge || (payload->bytes && !payload->word) ||
+	    !mc16_payload_length_encode(state, payload->bytes, &length) ||
+	    !mc16_swap_decode(expected_word, expected_length, &old) ||
+	    !swp_entry(old.type, old.swap_offset).val)
+		return -EINVAL;
+	if (objcg && payload->bytes) {
+		ret = memcomp_objcg_charge(objcg, gfp, payload->bytes);
+		if (ret)
+			return ret;
+		charged = payload->bytes;
+	}
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (!mc16_view_locked(ref, &view) || !mc16_flags_valid(*view.flags)) {
+		ret = -EIO;
+	} else if (mc16_flags_state(*view.flags) == MC16_SWAPPED &&
+	    *view.word == expected_word && *view.length == expected_length) {
+		*tail = (struct mc16_swapoff_tail) {
+			.swap = swp_entry(old.type, old.swap_offset),
+			.old_bytes = old.length, .new_bytes = payload->bytes,
+		};
+		*view.word = payload->word;
+		*view.length = length;
+		*view.flags = (*view.flags & ~MC16_STATE_MASK) | state;
+		if (view.member)
+			view.member->payload_charge = charged;
+		mc16_payload_account(MC16_SWAPPED, old.length, state, payload->bytes);
+		mc16_fifo_transition(ref, MC16_SWAPPED, state);
+		*payload = (struct mc16_payload) { };
+		ret = 1;
+	}
+	mutex_unlock(memcomp_lock_of(ref->token));
+	if (ret != 1)
+		memcomp_objcg_uncharge(objcg, charged);
+	return ret;
+}
+
+/* Match swapoff's two ordinary backing puts; swap core drains its cache. */
+static inline void mc16_swapoff_finish(struct mc16_swapoff_tail *tail)
+{
+	if (!tail->swap.val)
+		return;
+	memcomp_slot_put(tail->swap);
+	memcomp_debug_long_dec(&memcomp_swapped_entries);
+	if (tail->new_bytes != tail->old_bytes) {
+		memcomp_compressed_bytes_add(tail->new_bytes);
+		memcomp_compressed_bytes_sub(tail->old_bytes);
+	}
+	*tail = (struct mc16_swapoff_tail) { };
+}
+
+/* A guarded restore actor; W and periodic yield belong to the outer walker. */
+static inline int
+mc16_swapoff_entry(struct memcomp_ref *ref, unsigned int type,
+		   const struct memcomp_swapoff_ops *ops)
+{
+	struct mc16_swapoff_tail tail = { };
+	struct mc16_payload payload = { };
+	struct mc16_swap_fields fields;
+	struct mc16_view view;
+	unsigned long handle = 0;
+	unsigned int bytes = 0;
+	swp_entry_t swap;
+	u64 word;
+	u16 length;
+	u8 pool = 0;
+	void *buf;
+	int ret;
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	if (!mc16_view_locked(ref, &view) || !mc16_flags_valid(*view.flags)) {
+		ret = -EIO;
+		goto out_unlock;
+	}
+	if (*mc16_shadow_ptr(ref) == MC16_SHADOW_PUBLISHING) {
+		ret = 0;
+		goto out_unlock;
+	}
+	if (mc16_flags_state(*view.flags) != MC16_SWAPPED) {
+		ret = 0;
+		goto out_unlock;
+	}
+	word = *view.word;
+	length = *view.length;
+	if (!mc16_swap_decode(word, length, &fields)) {
+		ret = -EIO;
+		goto out_unlock;
+	}
+	swap = swp_entry(fields.type, fields.swap_offset);
+	if (!swap.val) {
+		ret = -EIO;
+		goto out_unlock;
+	}
+	ret = memcomp_slot_dup(swap);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	if (ret)
+		return ret;
+	if (fields.type != type) {
+		ret = 0;
+		goto out_read_ref;
+	}
+	if (ops->interrupted(ops->ctx)) {
+		ret = -EINTR;
+		goto out_read_ref;
+	}
+	buf = kmalloc(PAGE_SIZE, GFP_NOFS | __GFP_NOWARN);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto out_read_ref;
+	}
+	ret = ops->read_page(swap, buf);
+	if (ret) {
+		kfree(buf);
+		goto out_failed;
+	}
+	memcomp_debug_inc(&memcomp_swapoff_read_io);
+	if (fields.packed) {
+		void *page = kmalloc(PAGE_SIZE, GFP_NOFS | __GFP_NOWARN);
+
+		ret = page ? memcomp_decode_slot(buf, true, fields.byte_offset,
+						fields.length, page) : -ENOMEM;
+		kfree(buf);
+		buf = page;
+		if (ret) {
+			kfree(buf);
+			goto out_failed;
+		}
+	}
+	ret = ops->alloc_payload(buf, &bytes, &handle, &pool, ops->ctx);
+	kfree(buf);
+	if (ret)
+		goto out_failed;
+	payload = (struct mc16_payload) { .word = handle, .bytes = bytes };
+	ret = pool ? -EINVAL :
+		mc16_swapoff_commit(ref, word, length, &payload,
+				    GFP_NOIO | __GFP_NOWARN, &tail);
+	if (ret <= 0) {
+		if (bytes)
+			ops->free_payload(pool, handle, ops->ctx);
+		if (ret < 0)
+			goto out_failed;
+		goto out_read_ref;
+	}
+	/* Consume the read pin separately from the old slot-owned reference. */
+	memcomp_slot_put(swap);
+	mc16_swapoff_finish(&tail);
+	memcomp_debug_inc(&memcomp_swapoff_entries);
+	return 1;
+out_failed:
+	memcomp_debug_inc(&memcomp_swapoff_fail);
+out_read_ref:
+	memcomp_slot_put(swap);
+	return ret;
+out_unlock:
+	if (ret < 0)
+		memcomp_debug_inc(&memcomp_swapoff_fail);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return ret;
+}
+#endif /* CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_SWAPOFF_H */
diff --git a/mm/memcomp/swapoff_walk.h b/mm/memcomp/swapoff_walk.h
new file mode 100644
index 000000000..518dc12e3
--- /dev/null
+++ b/mm/memcomp/swapoff_walk.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_SWAPOFF_WALK_H
+#define _MM_MEMCOMP_SWAPOFF_WALK_H
+
+#include "scan.h"
+
+#ifdef CONFIG_SWAP
+#define MC16_SWAPOFF_SCAN_BATCH 32U
+
+/*
+ * All required ops and ctx remain valid until the walk returns. flush returns
+ * zero or -errno and settles all staging under W. restore borrows ref; it
+ * owns state/type validation and must return with all actor-local resources
+ * released, without consuming or retaining the scanner's guard.
+ *
+ * interrupted may be NULL to use signal_pending(current). The optional test
+ * observers borrow their arguments only for the call: scanned runs under W,
+ * unlocked runs with no W and no scanner/actor guard. Neither may retain a
+ * slot, cluster, record or backing snapshot across W. Production bindings
+ * (mc16_swapoff_entry and the slot batch flush) are supplied by the caller.
+ */
+struct mc16_swapoff_walk_ops {
+	struct mutex *lock; /* Shared writeback mutex W. */
+	int (*flush)(void *ctx);
+	int (*restore)(struct memcomp_ref *ref, unsigned int type, void *ctx);
+	bool (*interrupted)(void *ctx);
+	void (*scanned)(u64 cursor, unsigned int used,
+			enum mc16_scan_result result,
+			const struct memcomp_ref *ref, void *ctx);
+	void (*unlocked)(void *ctx);
+	void *ctx;
+};
+
+static inline bool
+mc16_swapoff_walk_interrupted(const struct mc16_swapoff_walk_ops *ops)
+{
+	return ops->interrupted ? ops->interrupted(ops->ctx) :
+		signal_pending(current);
+}
+
+/*
+ * Caller cancels any W-taking drain work before entry. The same W serializes
+ * every flush and restore. Only a u64 forward cursor survives a batch unlock;
+ * no saved registry, new lookup or T acquisition is needed.
+ * The 32-position bound inherits scan.h's XA_RETRY_ENTRY retry exception and
+ * is not a fixed scheduling/latency bound. A full slice yields even when EOF
+ * is discovered only by the next scan; a known end never needs another flush.
+ */
+static inline int
+mc16_swapoff_walk(unsigned int type, const struct mc16_swapoff_walk_ops *ops)
+{
+	unsigned int nofs_flag, noreclaim_flag, scanned = 0;
+	u64 cursor = 0;
+	int ret;
+
+	nofs_flag = memalloc_nofs_save();
+	noreclaim_flag = memalloc_noreclaim_save();
+	mutex_lock(ops->lock);
+	ret = ops->flush(ops->ctx);
+	if (ret)
+		goto out_unlock;
+	for (;;) {
+		struct memcomp_ref ref = { };
+		enum mc16_scan_result result;
+		unsigned int used;
+
+		if (mc16_swapoff_walk_interrupted(ops)) {
+			ret = -EINTR;
+			break;
+		}
+		result = mc16_scan_next(&cursor,
+					MC16_SWAPOFF_SCAN_BATCH - scanned, &ref, &used);
+		scanned += used;
+		if (ops->scanned)
+			ops->scanned(cursor, used, result, &ref, ops->ctx);
+		/* As in the old walk, an empty EOF ends before another signal check. */
+		if (result == MC16_SCAN_END && !used)
+			break;
+		if (mc16_swapoff_walk_interrupted(ops)) {
+			if (ref.slot)
+				mc16_ref_put(&ref);
+			ret = -EINTR;
+			break;
+		}
+		if (result == MC16_SCAN_GUARD) {
+			ret = ops->restore(&ref, type, ops->ctx);
+			mc16_ref_put(&ref);
+			if (ret < 0)
+				break;
+			/* Counts restored by the actor must not reach try_to_unuse. */
+			ret = 0;
+		}
+		if (mc16_swapoff_walk_interrupted(ops)) {
+			ret = -EINTR;
+			break;
+		}
+		if (result == MC16_SCAN_END || cursor == MC16_SCAN_END_CURSOR)
+			break;
+		if (scanned == MC16_SWAPOFF_SCAN_BATCH) {
+			/* ref is empty; no scanner or actor resource survives W. */
+			mutex_unlock(ops->lock);
+			if (ops->unlocked)
+				ops->unlocked(ops->ctx);
+			cond_resched();
+			mutex_lock(ops->lock);
+			/* A writer may have retired slots and staged new writes. */
+			ret = ops->flush(ops->ctx);
+			if (ret)
+				break;
+			scanned = 0;
+		} else {
+			cond_resched();
+		}
+	}
+out_unlock:
+	mutex_unlock(ops->lock);
+	memalloc_noreclaim_restore(noreclaim_flag);
+	memalloc_nofs_restore(nofs_flag);
+	return ret;
+}
+#endif /* CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_SWAPOFF_WALK_H */
diff --git a/mm/memcomp/workingset_load.h b/mm/memcomp/workingset_load.h
new file mode 100644
index 000000000..f939a2d39
--- /dev/null
+++ b/mm/memcomp/workingset_load.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_WORKINGSET_LOAD_H
+#define _MM_MEMCOMP_WORKINGSET_LOAD_H
+
+#include <linux/delayacct.h>
+#include <linux/psi.h>
+
+/*
+ * The guard pins the immutable source ID independently of objcg reparenting.
+ * Charge may reclaim: callers retain no record pointer or T/PTL/XA lock.
+ */
+static inline int mc16_user_charge(struct memcomp_ref *ref, struct folio *folio,
+				   struct mm_struct *mm, gfp_t gfp)
+{
+	return mem_cgroup_memcomp_charge(folio, mm, gfp,
+					 ref->cluster->key->owner_id);
+}
+
+/*
+ * Charge precedes this transaction. Stable nonresident slots never return to
+ * PENDING. First validate the whole guarded span, then take-clear each word
+ * under its own T. No T survives the call into the stock workingset policy.
+ * Like swapcache insertion, a later read/install failure does not undo it.
+ */
+static inline int mc16_user_refault(struct memcomp_ref *refs, unsigned int nr,
+				    struct folio *folio)
+{
+	unsigned long shadow = 0;
+	unsigned int i;
+
+	for (i = 0; i < nr; i++) {
+		struct mc16_view view;
+		u64 *word;
+		int ret = 0;
+
+		mutex_lock(memcomp_lock_of(refs[i].token));
+		word = mc16_shadow_ptr(&refs[i]);
+		if (!word || !mc16_view_locked(&refs[i], &view) ||
+		    !mc16_flags_valid(*view.flags))
+			ret = -EIO;
+		else if (mc16_flags_state(*view.flags) == MC16_PENDING ||
+			 (*view.flags & MC16_F_RESIDENT) ||
+			 *word == MC16_SHADOW_PUBLISHING)
+			ret = -EAGAIN;
+		else if (*word && !xa_is_value((void *)(unsigned long)*word))
+			ret = -EIO;
+		mutex_unlock(memcomp_lock_of(refs[i].token));
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < nr; i++) {
+		u64 *word;
+
+		mutex_lock(memcomp_lock_of(refs[i].token));
+		word = mc16_shadow_ptr(&refs[i]);
+		if (!i)
+			shadow = *word;
+		*word = 0;
+		mutex_unlock(memcomp_lock_of(refs[i].token));
+	}
+	if (shadow)
+		workingset_refault(folio, (void *)shadow);
+	return 0;
+}
+
+struct mc16_user_read {
+	unsigned long pflags;
+	bool in_thrashing;
+	bool workingset;
+};
+
+static inline void mc16_user_read_start(struct mc16_user_read *scope,
+					struct folio *folio)
+{
+	scope->workingset = folio_test_workingset(folio);
+	if (scope->workingset) {
+		delayacct_thrashing_start(&scope->in_thrashing);
+		psi_memstall_enter(&scope->pflags);
+	}
+	delayacct_swapin_start();
+}
+
+static inline void mc16_user_read_end(struct mc16_user_read *scope)
+{
+	if (scope->workingset) {
+		delayacct_thrashing_end(&scope->in_thrashing);
+		psi_memstall_leave(&scope->pflags);
+	}
+	delayacct_swapin_end();
+}
+
+static inline void mc16_user_major(struct mm_struct *mm)
+{
+	count_vm_event(PGMAJFAULT);
+	count_memcg_event_mm(mm, PGMAJFAULT);
+}
+#endif /* _MM_MEMCOMP_WORKINGSET_LOAD_H */
diff --git a/mm/memcomp/workingset_store.h b/mm/memcomp/workingset_store.h
new file mode 100644
index 000000000..7943f4d43
--- /dev/null
+++ b/mm/memcomp/workingset_store.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_WORKINGSET_STORE_H
+#define _MM_MEMCOMP_WORKINGSET_STORE_H
+
+/*
+ * Author: nakixii
+ *
+ * Include after storage/access/refs. A slot guard protects the side word;
+ * its token mutex T serializes every change. PUBLISHING excludes payload
+ * readers and background actors, not token reference removal by PTE zap.
+ * Only a source OWNER in its first PENDING epoch can open this gate.
+ */
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+#include <kunit/static_stub.h>
+static void *mc16_store_eviction(struct folio *folio,
+				 struct mem_cgroup *target_memcg)
+{
+	KUNIT_STATIC_STUB_REDIRECT(mc16_store_eviction, folio, target_memcg);
+	return workingset_memcomp_eviction(folio, target_memcg);
+}
+#else
+#define mc16_store_eviction workingset_memcomp_eviction
+#endif
+
+static inline int
+mc16_store_begin_locked(struct memcomp_ref *ref, struct folio *folio,
+			unsigned int nr, unsigned int index)
+{
+	struct mc16_view view;
+
+	lockdep_assert_held(memcomp_lock_of(ref->token));
+	if (!mc16_owner_matches_locked(ref, folio, nr, index) ||
+	    !mc16_view_locked(ref, &view) || !mc16_flags_valid(*view.flags) ||
+	    mc16_flags_state(*view.flags) != MC16_PENDING ||
+	    !(*view.flags & MC16_F_RESIDENT) || *mc16_shadow_ptr(ref))
+		return -EAGAIN;
+	*mc16_shadow_ptr(ref) = MC16_SHADOW_PUBLISHING;
+	return 0;
+}
+
+/*
+ * The caller has crossed its last fallible point with all span guards held.
+ * The source folio lock, source OWNER and PUBLISHING prevent any actor from
+ * changing this epoch. No T, PTL or XArray lock is held during eviction.
+ * Each base page gets the same stock shadow, with one folio-sized delta.
+ */
+static inline void
+mc16_store_publish(struct memcomp_ref *refs, unsigned int nr, void *shadow)
+{
+	unsigned int i;
+
+	for (i = 0; i < nr; i++) {
+		mutex_lock(memcomp_lock_of(refs[i].token));
+		VM_WARN_ON_ONCE(*mc16_shadow_ptr(&refs[i]) != MC16_SHADOW_PUBLISHING);
+		/* Make this epoch's shadow visible before admitting user reads. */
+		smp_store_release(mc16_shadow_ptr(&refs[i]),
+				  (u64)(unsigned long)shadow);
+		mutex_unlock(memcomp_lock_of(refs[i].token));
+	}
+}
+
+#endif /* _MM_MEMCOMP_WORKINGSET_STORE_H */
diff --git a/mm/memcomp/writeback.h b/mm/memcomp/writeback.h
new file mode 100644
index 000000000..598ba2b4f
--- /dev/null
+++ b/mm/memcomp/writeback.h
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_WRITEBACK_H
+#define _MM_MEMCOMP_WRITEBACK_H
+
+/* Include after access/fifo. All *_locked helpers borrow the caller's T. */
+struct mc16_writeback {
+	struct mc16_slot *slot;
+	u64 word;
+	u16 length;
+};
+
+/* Only old payload ownership, never a borrowed record/member pointer. */
+struct mc16_writeback_tail {
+	u64 word;
+	u32 charge;
+};
+
+/*
+ * The writer keeps a continuous slot guard from claim through finish. The
+ * snapshot's length is encoded, not bytes. It remains valid if owner-drop
+ * normalizes WRITEBACK; the guard alone does not pin the original record.
+ * Rejection leaves the snapshot untouched. One original eligibility L only.
+ */
+static inline bool
+mc16_writeback_claim_locked(struct memcomp_ref *ref,
+			    struct mc16_writeback *snapshot)
+{
+	struct mc16_view view;
+	u32 bytes;
+
+	if (*mc16_shadow_ptr(ref) == MC16_SHADOW_PUBLISHING ||
+	    !mc16_view_locked(ref, &view) ||
+	    !mc16_flags_valid(*view.flags) ||
+	    mc16_flags_state(*view.flags) != MC16_STORED ||
+	    (*view.flags & MC16_F_RESIDENT) || !*view.word ||
+	    !mc16_length_decode(*view.length, &bytes))
+		return false;
+	*snapshot = (struct mc16_writeback) {
+		.slot = ref->slot, .word = *view.word, .length = *view.length,
+	};
+	*view.flags = (*view.flags & ~MC16_STATE_MASK) | MC16_WRITEBACK;
+	mc16_fifo_transition(ref, MC16_STORED, MC16_WRITEBACK);
+	return true;
+}
+
+/* Idempotent failed-I/O rollback; no payload, charge or backing is consumed. */
+static inline bool mc16_writeback_revert_locked(struct memcomp_ref *ref)
+{
+	struct mc16_view view;
+
+	if (!mc16_view_locked(ref, &view) ||
+	    mc16_flags_state(*view.flags) != MC16_WRITEBACK)
+		return false;
+	*view.flags = (*view.flags & ~MC16_STATE_MASK) | MC16_STORED;
+	mc16_fifo_transition(ref, MC16_WRITEBACK, MC16_STORED);
+	return true;
+}
+
+/*
+ * Caller already owns ONE backing reference described by swap, even for a
+ * packed member. Success transfers it to this slot without a dup or put.
+ * The backing fields are real device type/offset/byte offset/length, not
+ * swap.val in word. Raw backing still preserves the old compressed length.
+ * Backing allocation, I/O and backing-device validation belong to caller.
+ *
+ * tail must be empty. On success finish it outside T BEFORE putting this
+ * guard, which keeps the key's accounting owner alive. OWNER retains the
+ * record; owner-drop may instead already have detached/freed it. Resolve
+ * the effective view afresh under T on every attempt. No extra T/A/X/RMW,
+ * and no L on success (WRITEBACK and SWAPPED are both ineligible).
+ *
+ * Rejection leaves tail and caller's backing ownership untouched. A payload
+ * identity mismatch rolls WRITEBACK back to STORED;
+ * invalid backing encoding leaves WRITEBACK for the caller's I/O rollback.
+ */
+static inline int
+mc16_writeback_settle_locked(struct memcomp_ref *ref,
+			     const struct mc16_writeback *snapshot,
+			     const struct mc16_swap_fields *swap,
+			     struct mc16_writeback_tail *tail)
+{
+	struct mc16_view view;
+	u64 word;
+	u32 bytes;
+	u16 length;
+
+	lockdep_assert_held(memcomp_lock_of(ref->token));
+	if (snapshot->slot != ref->slot || !mc16_view_locked(ref, &view) ||
+	    mc16_flags_state(*view.flags) != MC16_WRITEBACK)
+		return -ESTALE;
+	if (*view.word != snapshot->word || *view.length != snapshot->length) {
+		mc16_writeback_revert_locked(ref);
+		return -ESTALE;
+	}
+	if (!mc16_flags_valid(*view.flags) ||
+	    (*view.flags & MC16_F_RESIDENT) || !*view.word ||
+	    !mc16_length_decode(*view.length, &bytes))
+		return -EIO;
+	if (tail->word || tail->charge || !swap || swap->length != bytes ||
+	    !mc16_swap_encode(swap->type, swap->swap_offset, swap->byte_offset,
+			      swap->length, swap->packed, &word, &length) ||
+	    !swp_entry(swap->type, swap->swap_offset).val)
+		return -EINVAL;
+
+	*tail = (struct mc16_writeback_tail) {
+		.word = *view.word,
+		.charge = view.member ? view.member->payload_charge :
+			(ref->cluster->key->objcg ? bytes : 0),
+	};
+	*view.word = word;
+	*view.length = length;
+	*view.flags = (*view.flags & ~MC16_STATE_MASK) | MC16_SWAPPED;
+	if (view.member)
+		view.member->payload_charge = 0;
+	/* Length, raw/samefill, stored and compressed gauges do not change. */
+	memcomp_debug_long_inc(&memcomp_swapped_entries);
+	if (swap->packed)
+		memcomp_debug_inc(&memcomp_writeback_packed_payloads);
+	return 0;
+}
+
+/* No backing put: that reference now belongs to the effective SWAPPED slot. */
+static inline void
+mc16_writeback_finish(struct memcomp_ref *ref,
+		      struct mc16_writeback_tail *tail)
+{
+	if (!tail->word)
+		return;
+	memcomp_zs_free(0, tail->word);
+	memcomp_objcg_uncharge(ref->cluster->key->objcg, tail->charge);
+	*tail = (struct mc16_writeback_tail) { };
+}
+#endif /* _MM_MEMCOMP_WRITEBACK_H */
diff --git a/mm/memcomp/writeback_batch.h b/mm/memcomp/writeback_batch.h
new file mode 100644
index 000000000..de5f62a6e
--- /dev/null
+++ b/mm/memcomp/writeback_batch.h
@@ -0,0 +1,398 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_WRITEBACK_BATCH_H
+#define _MM_MEMCOMP_WRITEBACK_BATCH_H
+
+#ifdef CONFIG_SWAP
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+#include <kunit/static_stub.h>
+#endif
+
+/*
+ * Include in memcomp.c after the old writeback batch implementation.  Uses
+ * the existing W, backing slot pool, swapcache folio helpers and I/O plug.
+ * No production dispatch is changed by including this header.
+ *
+ * The caller holds memcomp_writeback_lock once for the whole pass, within
+ * its existing nofs/noreclaim scope.  Never mix old and mc16 live batches:
+ * both borrow the shared slot pool and plug.  Flush before dropping W,
+ * including every error/early-exit path and before a swapoff walk.
+ *
+ * stage_locked() borrows the caller's existing T acquisition to claim and
+ * clone exactly one staging guard.  Release T, then stage() consumes that
+ * guard on every outcome.  The caller still puts its own lookup guard.
+ * stage_abort() is the alternative if the caller cannot proceed to stage().
+ * No I/O, allocation, numeric lookup or new lock acquisition occurs in
+ * stage_locked().  The batch guard survives OWNER removal/normalization;
+ * no record/member address is saved here.  The successful pass retains the
+ * existing T3/L2/refs4/W1 budget; the selector's and validation's T/L scopes
+ * remain the caller's, and settle uses one T with no eligibility L.
+ */
+struct mc16_writeback_member {
+	struct memcomp_ref ref;
+	struct mc16_writeback snapshot;
+	u32 length;
+	u16 offset;
+};
+
+struct mc16_writeback_slot {
+	struct folio *folio;
+	swp_entry_t swap;
+	unsigned int first;
+	u8 nr;
+	bool packed;
+};
+
+static struct mc16_writeback_slot
+	mc16_writeback_batch[MEMCOMP_WRITEBACK_BATCH];
+static struct mc16_writeback_member
+	mc16_writeback_members[MEMCOMP_WRITEBACK_BATCH *
+			       MEMCOMP_WRITEBACK_PACK_MAX];
+static unsigned int mc16_writeback_batch_used;
+static unsigned int mc16_writeback_members_used;
+static unsigned int mc16_writeback_open_first;
+static unsigned int mc16_writeback_open_bytes;
+
+/* Test seams preserve the production allocator, submit and backing APIs. */
+static int mc16_writeback_folio_alloc(struct folio **folio, swp_entry_t *swap)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_writeback_folio_alloc, folio, swap);
+#endif
+	return memcomp_swap_folio_alloc(folio, swap);
+}
+
+static void mc16_writeback_submit(struct folio *folio,
+				  struct writeback_control *wbc)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_writeback_submit, folio, wbc);
+#endif
+	__swap_writepage(&folio->page, wbc);
+}
+
+static int mc16_writeback_backing_dup(swp_entry_t swap)
+{
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	KUNIT_STATIC_STUB_REDIRECT(mc16_writeback_backing_dup, swap);
+#endif
+	return memcomp_slot_dup(swap);
+}
+
+static void mc16_writeback_member_put(struct mc16_writeback_member *m)
+{
+	if (m->ref.slot)
+		mc16_ref_put(&m->ref);
+	*m = (struct mc16_writeback_member) { };
+}
+
+/* Outside T. Only the staging guard is consumed; never the caller's guard. */
+static void mc16_writeback_stage_abort(struct mc16_writeback_member *m)
+{
+	lockdep_assert_held(&memcomp_writeback_lock);
+	if (!m->ref.slot)
+		return;
+	mutex_lock(memcomp_lock_of(m->ref.token));
+	mc16_writeback_revert_locked(&m->ref);
+	mutex_unlock(memcomp_lock_of(m->ref.token));
+	mc16_writeback_member_put(m);
+}
+
+static inline bool mc16_writeback_batch_full(void)
+{
+	return mc16_writeback_batch_used + 1 >= MEMCOMP_WRITEBACK_BATCH ||
+	       mc16_writeback_members_used >= ARRAY_SIZE(mc16_writeback_members);
+}
+
+/*
+ * staged is an empty caller-owned temporary, not another lookup.  On error
+ * it owns nothing and ref/state are unchanged.  A full batch must be flushed
+ * outside T before retrying; -ENOBUFS is not backing-device -ENOSPC.
+ */
+static inline int
+mc16_writeback_stage_locked(struct memcomp_ref *ref,
+			    struct mc16_writeback_member *staged)
+{
+	struct mc16_writeback snapshot;
+	u32 length = 0;
+
+	lockdep_assert_held(&memcomp_writeback_lock);
+	if (!ref || !ref->slot || !staged || staged->ref.slot)
+		return -EINVAL;
+	lockdep_assert_held(memcomp_lock_of(ref->token));
+	if (mc16_writeback_batch_full())
+		return -ENOBUFS;
+	if (!mc16_writeback_claim_locked(ref, &snapshot))
+		return -EAGAIN;
+	/* Claim already validated this encoding in its effective view. */
+	mc16_length_decode(snapshot.length, &length);
+	refcount_inc(&ref->slot->refs);
+	*staged = (struct mc16_writeback_member) {
+		.ref = *ref, .snapshot = snapshot, .length = length,
+	};
+	return 0;
+}
+
+/*
+ * One owned backing reference enters; success transfers it to the slot.
+ * Resolve the effective view under T, then finish before putting this guard.
+ * Rejections, including an unencodable backing, revert in this same T scope.
+ */
+static int mc16_writeback_convert(struct mc16_writeback_member *m,
+				  swp_entry_t swap, bool packed)
+{
+	struct mc16_swap_fields fields = {
+		.swap_offset = swp_offset(swap),
+		.byte_offset = packed ? m->offset : 0,
+		.length = m->length,
+		.type = swp_type(swap),
+		.packed = packed,
+	};
+	struct mc16_writeback_tail tail = { };
+	int ret;
+
+	mutex_lock(memcomp_lock_of(m->ref.token));
+	ret = mc16_writeback_settle_locked(&m->ref, &m->snapshot, &fields,
+					   &tail);
+	if (ret)
+		mc16_writeback_revert_locked(&m->ref);
+	mutex_unlock(memcomp_lock_of(m->ref.token));
+	mc16_writeback_finish(&m->ref, &tail);
+	return ret;
+}
+
+/* The swapcache folio still pins the backing while duplicates are taken. */
+static int mc16_writeback_resolve(struct mc16_writeback_slot *s,
+				  unsigned long *freedp)
+{
+	bool base = true;
+	unsigned int i;
+	int error = 0;
+
+	for (i = s->first; i < s->first + s->nr; i++) {
+		struct mc16_writeback_member *m = &mc16_writeback_members[i];
+		int ret;
+
+		ret = base ? 0 : mc16_writeback_backing_dup(s->swap);
+		if (ret) {
+			/* Failed dup created no backing reference to refund. */
+			mc16_writeback_stage_abort(m);
+		} else {
+			base = false;
+			ret = mc16_writeback_convert(m, s->swap, s->packed);
+			if (ret) {
+				memcomp_slot_put(s->swap);
+			} else {
+				memcomp_debug_inc(&memcomp_writeback_payloads);
+				if (freedp)
+					(*freedp)++;
+			}
+			mc16_writeback_member_put(m);
+		}
+		if (ret && !error)
+			error = ret;
+	}
+	return error;
+}
+
+/*
+ * Submit one raw page or a packed slot, without T.  The snapshots remain
+ * immutable while WRITEBACK, even if a producer detaches its record.  Pool 0
+ * is the mc16 payload pool; snapshot.length is encoded, m->length is bytes.
+ */
+static int mc16_writeback_write_slot(unsigned int first, unsigned int nr)
+{
+	struct writeback_control wbc = {
+		.sync_mode = WB_SYNC_NONE,
+		.swap_plug = &memcomp_writeback_plugged,
+	};
+	struct mc16_writeback_slot *s;
+	bool packed = nr > 1;
+	unsigned int off = 0, i;
+	struct folio *folio;
+	swp_entry_t swap;
+	void *dst;
+	int ret;
+
+	lockdep_assert_held(&memcomp_writeback_lock);
+	if (WARN_ON_ONCE(mc16_writeback_batch_used >= MEMCOMP_WRITEBACK_BATCH ||
+			 !nr || nr > MEMCOMP_WRITEBACK_PACK_MAX ||
+			 first > mc16_writeback_members_used ||
+			 nr > mc16_writeback_members_used - first))
+		return -EIO;
+	ret = mc16_writeback_folio_alloc(&folio, &swap);
+	if (ret)
+		return ret;
+
+	dst = kmap_local_folio(folio, 0);
+	for (i = first; i < first + nr; i++) {
+		struct mc16_writeback_member *m = &mc16_writeback_members[i];
+		u16 encoded_length;
+		u64 encoded_word;
+		void *src;
+
+		/* Refuse unsupported backing geometry before any I/O is issued. */
+		if (!swap.val || !mc16_swap_encode(swp_type(swap), swp_offset(swap),
+						   packed ? off : 0, m->length,
+						   packed, &encoded_word,
+						   &encoded_length)) {
+			ret = -ERANGE;
+			break;
+		}
+		src = zs_map_object(memcomp_pools[0], m->snapshot.word, ZS_MM_RO);
+		if (!src) {
+			ret = -EIO;
+			break;
+		}
+		m->offset = packed ? off : 0;
+		if (packed) {
+			memcpy(dst + off, src, m->length);
+			off += m->length;
+		} else {
+			ret = memcomp_decompress_payload(src, m->length, dst);
+			if (ret)
+				memcomp_debug_inc(&memcomp_writeback_decompress_error);
+		}
+		zs_unmap_object(memcomp_pools[0], m->snapshot.word);
+		if (ret)
+			break;
+	}
+	if (!ret && packed)
+		memset(dst + off, 0, PAGE_SIZE - off);
+	kunmap_local(dst);
+	if (ret) {
+		memcomp_drop_swapcache_folio(folio, false);
+		memcomp_slot_put(swap);
+		return ret;
+	}
+
+	folio_set_reclaim(folio);
+	__folio_mark_uptodate(folio);
+	mc16_writeback_submit(folio, &wbc);
+	s = &mc16_writeback_batch[mc16_writeback_batch_used++];
+	*s = (struct mc16_writeback_slot) {
+		.folio = folio, .swap = swap, .first = first,
+		.nr = nr, .packed = packed,
+	};
+	if (packed)
+		memcomp_debug_inc(&memcomp_writeback_packed_slots);
+	return 0;
+}
+
+static int mc16_writeback_close_open(void)
+{
+	unsigned int first = mc16_writeback_open_first;
+	unsigned int nr = mc16_writeback_members_used - first;
+	unsigned int i;
+	int ret = 0;
+
+	if (nr)
+		ret = mc16_writeback_write_slot(first, nr);
+	if (ret) {
+		for (i = first; i < first + nr; i++)
+			mc16_writeback_stage_abort(&mc16_writeback_members[i]);
+		mc16_writeback_members_used = first;
+	}
+	mc16_writeback_open_first = mc16_writeback_members_used;
+	mc16_writeback_open_bytes = 0;
+	return ret;
+}
+
+/*
+ * Outside T, consumes staged on success AND failure.  A failed close of the
+ * preceding open page also returns this newly claimed member to STORED.
+ * Caller must flush submitted slots even if this function returns an error.
+ */
+static inline int mc16_writeback_stage(struct mc16_writeback_member *staged)
+{
+	struct mc16_writeback_member *m;
+	unsigned int nr;
+	int ret;
+
+	lockdep_assert_held(&memcomp_writeback_lock);
+	if (!staged || !staged->ref.slot)
+		return -EINVAL;
+	if (WARN_ON_ONCE(mc16_writeback_batch_full())) {
+		ret = -ENOBUFS;
+		goto abort;
+	}
+	nr = mc16_writeback_members_used - mc16_writeback_open_first;
+	if (!memcomp_writeback_pack_fits(nr, mc16_writeback_open_bytes,
+					 staged->length)) {
+		ret = mc16_writeback_close_open();
+		if (ret)
+			goto abort;
+	}
+	m = &mc16_writeback_members[mc16_writeback_members_used++];
+	*m = *staged;
+	*staged = (struct mc16_writeback_member) { };
+	mc16_writeback_open_bytes += m->length;
+	if (m->length == PAGE_SIZE)
+		return mc16_writeback_close_open();
+	return 0;
+abort:
+	mc16_writeback_stage_abort(staged);
+	return ret;
+}
+
+/*
+ * Unplug before the wait sweep, resolve only after I/O, then return every
+ * unused reservation.  No staging guard or prefetched backing crosses W.
+ * Successful slots can settle even if a sibling slot failed; ret is the
+ * first close/I/O/settle error and freedp counts only committed payloads.
+ */
+static inline int mc16_writeback_batch_flush(unsigned long *freedp)
+{
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&memcomp_writeback_lock);
+	ret = mc16_writeback_close_open();
+	if (memcomp_writeback_plugged) {
+		swap_write_unplug(memcomp_writeback_plugged);
+		memcomp_writeback_plugged = NULL;
+	}
+	for (i = 0; i < mc16_writeback_batch_used; i++)
+		folio_wait_writeback(mc16_writeback_batch[i].folio);
+	for (i = 0; i < mc16_writeback_batch_used; i++) {
+		struct mc16_writeback_slot *s = &mc16_writeback_batch[i];
+		struct folio *folio = s->folio;
+		int error;
+
+		folio_lock(folio);
+		if (folio_test_dirty(folio)) {
+			unsigned int j;
+
+			memcomp_drop_swapcache_folio(folio, true);
+			memcomp_debug_inc(&memcomp_writeback_write_error);
+			for (j = s->first; j < s->first + s->nr; j++)
+				mc16_writeback_stage_abort(&mc16_writeback_members[j]);
+			memcomp_slot_put(s->swap);
+			error = -EIO;
+		} else {
+			error = mc16_writeback_resolve(s, freedp);
+			memcomp_drop_swapcache_folio(folio, false);
+		}
+		if (error && !ret)
+			ret = error;
+		*s = (struct mc16_writeback_slot) { };
+	}
+	mc16_writeback_batch_used = 0;
+	mc16_writeback_members_used = 0;
+	mc16_writeback_open_first = 0;
+	mc16_writeback_open_bytes = 0;
+	memcomp_writeback_slots_return();
+	return ret;
+}
+
+/*
+ * Minimal KUnit seams above are folio_alloc, submit and backing_dup.  An
+ * allocator stub returns a locked folio plus one owned backing reference;
+ * a submit stub must unlock and complete writeback (dirty for failed I/O).
+ * Real compression/zsmalloc and the existing memcomp_slot_* tally model can
+ * cover raw/packed images, decoded-length boundaries, owner normalization
+ * between stage and settle, allocation/dup/dirty-I/O/settle failures and
+ * unused-slot refund.  Keep W and both T scopes out of fatal assertions;
+ * drain staged temporaries and flush in the test task before releasing W.
+ */
+#endif /* CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_WRITEBACK_BATCH_H */
diff --git a/mm/memcomp/zero.h b/mm/memcomp/zero.h
new file mode 100644
index 000000000..e5c5e67f1
--- /dev/null
+++ b/mm/memcomp/zero.h
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_ZERO_H
+#define _MM_MEMCOMP_ZERO_H
+
+#include <linux/compiler.h>
+#include <linux/limits.h>
+#include <asm/page.h>
+#include <linux/minmax.h>
+#include <linux/percpu.h>
+#include <linux/string.h>
+
+/*
+ * Pure-value ownership only: no slot, record, folio reference or objcg.
+ * The winning PTL/xa transaction accounts the actual committed owner count.
+ * Initial anonymous PTEs use pte_init; fork uses pte_get; removal uses pte_put.
+ * A failed installation accounts nothing, MOVE is neutral, and neither a
+ * transport folio nor a present shmem mapping owns an additional zero count.
+ * Cache ownership has its own get/put pair, independent of anonymous PTEs.
+ * These helpers neither publish PTEs nor select the producer's zero branch.
+ *
+ * The always-on production ledger is perCPU, not a new global hot-path RMW.
+ * Get and put may run on different CPUs, so individual CPU values can be
+ * negative. Sum ALL possible CPUs before interpreting either signed domain.
+ * Snapshots are observational, like the existing memcomp logical statistics;
+ * an in-flight cross-CPU transfer need not yield a transactional snapshot.
+ * There is no runtime reset and no per-CPU underflow test.
+ */
+struct mc16_zero_owners {
+	s64 pte_pages;
+	s64 cache_pages;
+};
+
+static DEFINE_PER_CPU(struct mc16_zero_owners, mc16_zero_owners);
+
+enum mc16_zero_event {
+	MC16_ZERO_PTE_INIT,
+	MC16_ZERO_PTE_GET,
+	MC16_ZERO_PTE_PUT,
+	MC16_ZERO_CACHE_GET,
+	MC16_ZERO_CACHE_PUT,
+	MC16_ZERO_EVENTS,
+};
+
+/* Separate from slot get/put, members, stored/compressed RMW and eligibility. */
+struct mc16_zero_diagnostics {
+	u64 calls[MC16_ZERO_EVENTS];
+	u64 pages[MC16_ZERO_EVENTS];
+};
+
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+static DEFINE_PER_CPU(struct mc16_zero_diagnostics, mc16_zero_diagnostics);
+#endif
+
+static inline void mc16_zero_event(enum mc16_zero_event event,
+				   unsigned long nr)
+{
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	this_cpu_inc(mc16_zero_diagnostics.calls[event]);
+	this_cpu_add(mc16_zero_diagnostics.pages[event], nr);
+#endif
+}
+
+/* Reject a wide unsigned input before signed conversion/negation. */
+static inline bool mc16_zero_nr_valid(unsigned long nr)
+{
+	return nr <= LONG_MAX;
+}
+
+static inline bool mc16_zero_pte_add(unsigned long nr,
+				     enum mc16_zero_event event)
+{
+	if (!mc16_zero_nr_valid(nr))
+		return false;
+	if (nr) {
+		this_cpu_add(mc16_zero_owners.pte_pages, (s64)nr);
+		mc16_zero_event(event, nr);
+	}
+	return true;
+}
+
+/* Initial committed PTEs, not fork gets and not a counter reset. */
+static inline bool mc16_zero_pte_init(unsigned long nr)
+{
+	return mc16_zero_pte_add(nr, MC16_ZERO_PTE_INIT);
+}
+
+static inline bool mc16_zero_pte_get(unsigned long nr)
+{
+	return mc16_zero_pte_add(nr, MC16_ZERO_PTE_GET);
+}
+
+/* Caller owns nr logical PTEs; this is not a speculative refcount put. */
+static inline bool mc16_zero_pte_put(unsigned long nr)
+{
+	if (!mc16_zero_nr_valid(nr))
+		return false;
+	if (nr) {
+		this_cpu_add(mc16_zero_owners.pte_pages, -(s64)nr);
+		mc16_zero_event(MC16_ZERO_PTE_PUT, nr);
+	}
+	return true;
+}
+
+static inline bool mc16_zero_cache_get(unsigned long nr)
+{
+	if (!mc16_zero_nr_valid(nr))
+		return false;
+	if (nr) {
+		this_cpu_add(mc16_zero_owners.cache_pages, (s64)nr);
+		mc16_zero_event(MC16_ZERO_CACHE_GET, nr);
+	}
+	return true;
+}
+
+static inline bool mc16_zero_cache_put(unsigned long nr)
+{
+	if (!mc16_zero_nr_valid(nr))
+		return false;
+	if (nr) {
+		this_cpu_add(mc16_zero_owners.cache_pages, -(s64)nr);
+		mc16_zero_event(MC16_ZERO_CACHE_PUT, nr);
+	}
+	return true;
+}
+
+/* Keep raw signed totals available to quiescent diagnostic/balance checks. */
+static inline void mc16_zero_owners_read(struct mc16_zero_owners *snapshot)
+{
+	u64 pte = 0, cache = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		const struct mc16_zero_owners *owners;
+
+		owners = per_cpu_ptr(&mc16_zero_owners, cpu);
+		/* Unsigned accumulation also handles negative perCPU contributions. */
+		pte += (u64)READ_ONCE(owners->pte_pages);
+		cache += (u64)READ_ONCE(owners->cache_pages);
+	}
+	snapshot->pte_pages = (s64)pte;
+	snapshot->cache_pages = (s64)cache;
+}
+
+static inline void
+mc16_zero_diagnostics_read(struct mc16_zero_diagnostics *snapshot)
+{
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	int cpu, event;
+#endif
+
+	memset(snapshot, 0, sizeof(*snapshot));
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	for_each_possible_cpu(cpu) {
+		const struct mc16_zero_diagnostics *debug;
+
+		debug = per_cpu_ptr(&mc16_zero_diagnostics, cpu);
+		for (event = 0; event < MC16_ZERO_EVENTS; event++) {
+			snapshot->calls[event] += READ_ONCE(debug->calls[event]);
+			snapshot->pages[event] += READ_ONCE(debug->pages[event]);
+		}
+	}
+#endif
+}
+
+static inline u64 mc16_zero_pages(void)
+{
+	struct mc16_zero_owners owners;
+
+	mc16_zero_owners_read(&owners);
+	/* Clamp only after summing each entire domain, never per CPU. */
+	return (u64)max_t(s64, 0, owners.pte_pages) +
+	       (u64)max_t(s64, 0, owners.cache_pages);
+}
+
+/*
+ * stat stored = slot stored + logical zero bytes, compressed = slot compressed.
+ * Do not also call the slot stored/compressed add/sub wrappers for zero owners,
+ * even with argument zero. No slot metadata, payload charge or eligible page.
+ * Debug samefill totals can add zero_pages once, as in the old zero backend.
+ */
+static inline u64 mc16_zero_stored_bytes(u64 slot_stored_bytes)
+{
+	return slot_stored_bytes + (mc16_zero_pages() << PAGE_SHIFT);
+}
+
+/* Already decoded MEMCOMP token only. Nonzero leaves optional outputs alone. */
+static inline bool mc16_zero_entry_stat(unsigned long token,
+					unsigned long *compressed, int *mapcount)
+{
+	if (token)
+		return false;
+	if (compressed)
+		*compressed = 0;
+	if (mapcount)
+		*mapcount = 1;
+	return true;
+}
+
+/* Exactly one readable base page; supports unaligned input, no codec/alloc. */
+static inline bool mc16_zero_is_page(const void *src, size_t bytes)
+{
+	return src && bytes == PAGE_SIZE && !memchr_inv(src, 0, PAGE_SIZE);
+}
+
+#endif /* _MM_MEMCOMP_ZERO_H */
diff --git a/mm/memcomp/zero_convert.h b/mm/memcomp/zero_convert.h
new file mode 100644
index 000000000..f4fa549d4
--- /dev/null
+++ b/mm/memcomp/zero_convert.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_ZERO_CONVERT_H
+#define _MM_MEMCOMP_ZERO_CONVERT_H
+
+/* Include after PTE map helpers, zero.h, refs.h and payload accessors. */
+struct mc16_zero_walk {
+	struct memcomp_ref ref;
+	unsigned int converted;
+};
+
+static bool mc16_zero_convert_one(struct folio *folio,
+				  struct vm_area_struct *vma,
+				  unsigned long address, void *arg)
+{
+	struct mc16_zero_walk *walk = arg;
+	struct mm_struct *mm = vma->vm_mm;
+	struct memcomp_ref removed;
+	spinlock_t *ptl; /* Protects the swap-format PTE transaction. */
+	pte_t *ptep;
+	pte_t orig;
+	pmd_t *pmd;
+
+	pmd = mm_find_pmd(mm, address);
+	if (!pmd || !memcomp_pte_map_lock(mm, pmd, address, &ptep, &ptl))
+		return true;
+	orig = ptep_get(ptep);
+	if (!is_swap_pte(orig) || pte_to_swp_entry(orig).val !=
+	    make_memcomp_entry(walk->ref.token).val) {
+		pte_unmap_unlock(ptep, ptl);
+		return true;
+	}
+
+	/* Only the winning PTL transaction creates a logical zero owner. */
+	set_pte_at(mm, address, ptep,
+		   pte_move_swp_offset(orig, -(long)walk->ref.token));
+	mc16_zero_pte_init(1);
+	/* Transfer the removed PTE's existing ownership, without a new get. */
+	removed = walk->ref;
+	mc16_ref_put(&removed);
+	pte_unmap_unlock(ptep, ptl);
+	walk->converted++;
+	return true;
+}
+
+/*
+ * Run after releasing the codec context and before dropping the pinned
+ * anon_vma. The folio remains locked through release_folio. A continuous
+ * source OWNER protects the borrowed carrier; no record/member is carried.
+ * Fork/MOVE may leave positive tokens behind: their SAMEFILL data stays
+ * valid, so this is a best-effort metadata saving, not a correctness gate.
+ */
+static inline unsigned int
+mc16_zero_convert_folio(struct folio *folio,
+			const struct mc16_zero_carrier *carrier)
+{
+	struct mc16_zero_walk walk = { };
+	struct rmap_walk_control rwc = {
+		.rmap_one = mc16_zero_convert_one,
+		.arg = &walk,
+	};
+	unsigned long token;
+
+	if (!carrier || !carrier->valid || !carrier->ready ||
+	    !carrier->ref.slot || !carrier->ref.cluster)
+		return 0;
+	token = carrier->token;
+	if (!folio_test_locked(folio) || folio_test_large(folio) ||
+	    !folio_test_anon(folio) || folio_mapped(folio) ||
+	    folio_maybe_dma_pinned(folio) || !token || token > U32_MAX ||
+	    carrier->ref.token != token ||
+	    !pages_identical(&folio->page, ZERO_PAGE(0)))
+		return 0;
+	/* OWNER survives until release_folio; only matching PTEs consume refs. */
+	walk.ref = carrier->ref;
+	rmap_walk(folio, &rwc);
+	return walk.converted;
+}
+#endif /* _MM_MEMCOMP_ZERO_CONVERT_H */
diff --git a/mm/memcomp/zero_load.h b/mm/memcomp/zero_load.h
new file mode 100644
index 000000000..efaeb83fb
--- /dev/null
+++ b/mm/memcomp/zero_load.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_ZERO_LOAD_H
+#define _MM_MEMCOMP_ZERO_LOAD_H
+
+#include <linux/highmem.h>
+
+/* Include after zero.h and memcomp_pte_map_lock(), in memcomp.c. */
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+/* Current-task failure injection only; successful data always uses real MM. */
+static struct {
+	struct task_struct *task;
+	bool fail_alloc;
+	bool fail_charge;
+} mc16_zero_fault_probe;
+#endif
+
+static inline vm_fault_t mc16_load_zero(struct vm_fault *vmf, bool *locked)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	struct folio *folio;
+	vm_fault_t ret;
+	pte_t pte;
+
+	if (locked)
+		*locked = false;
+	ret = vmf_anon_prepare(vmf);
+	if (ret)
+		return ret;
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	if (READ_ONCE(mc16_zero_fault_probe.task) == current &&
+	    mc16_zero_fault_probe.fail_alloc)
+		return VM_FAULT_OOM;
+#endif
+	folio = vma_alloc_zeroed_movable_folio(vma, vmf->address);
+	if (!folio)
+		return VM_FAULT_OOM;
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	if (READ_ONCE(mc16_zero_fault_probe.task) == current &&
+	    mc16_zero_fault_probe.fail_charge) {
+		folio_put(folio);
+		return VM_FAULT_OOM;
+	}
+#endif
+	if (mem_cgroup_charge(folio, vma->vm_mm, GFP_HIGHUSER_MOVABLE)) {
+		folio_put(folio);
+		return VM_FAULT_OOM;
+	}
+	__folio_set_locked(folio);
+	__folio_set_swapbacked(folio);
+	mc_folio_clear_swap(folio);
+	__folio_mark_uptodate(folio);
+	if (!memcomp_pte_map_lock(vma->vm_mm, vmf->pmd, vmf->address,
+				  &vmf->pte, &vmf->ptl))
+		goto out_free;
+	if (!pte_same(ptep_get(vmf->pte), vmf->orig_pte)) {
+		pte_unmap_unlock(vmf->pte, vmf->ptl);
+		vmf->pte = NULL;
+		goto out_free;
+	}
+
+	pte = mk_pte(&folio->page, vma->vm_page_prot);
+	if (pte_swp_soft_dirty(vmf->orig_pte))
+		pte = pte_mksoft_dirty(pte);
+	if (pte_swp_uffd_wp(vmf->orig_pte))
+		pte = pte_mkuffd_wp(pte);
+	if ((vma->vm_flags & VM_WRITE) && !userfaultfd_pte_wp(vma, pte) &&
+	    !pte_needs_soft_dirty_wp(vma, pte)) {
+		pte = pte_mkwrite(pte);
+		if (vmf->flags & FAULT_FLAG_WRITE)
+			pte = pte_mkdirty(pte);
+	}
+	flush_icache_pages(vma, &folio->page, 1);
+	folio_add_new_anon_rmap(folio, vma, vmf->address, RMAP_EXCLUSIVE);
+	folio_add_lru_vma(folio, vma);
+	set_pte_at(vma->vm_mm, vmf->address, vmf->pte, pte);
+	add_mm_counter(vma->vm_mm, MM_SWAPENTS, -1);
+	add_mm_counter(vma->vm_mm, MM_ANONPAGES, 1);
+	mc16_zero_pte_put(1);
+	arch_do_swap_page_nr(vma->vm_mm, vma, vmf->address, pte, pte, 1);
+	update_mmu_cache_range(vmf, vma, vmf->address, vmf->pte, 1);
+	folio_unlock(folio);
+	pte_unmap_unlock(vmf->pte, vmf->ptl);
+	vmf->pte = NULL;
+	return VM_FAULT_NOPAGE;
+
+out_free:
+	folio_unlock(folio);
+	folio_put(folio);
+	return 0;
+}
+#endif /* _MM_MEMCOMP_ZERO_LOAD_H */
