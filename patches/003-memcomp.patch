+#include <linux/highmem.h>
+#include <linux/xxhash.h>
+
+#define MEMCOMP_INCOMPRESSIBLE	BIT_ULL(32)
+
+static inline swp_entry_t memcomp_folio_swap_get(const struct folio *folio)
+{
+	return (swp_entry_t){ .val = (unsigned long)folio->private };
+}
+static inline bool memcomp_entry_is_mark(swp_entry_t entry)
+{
+	return is_memcomp_entry(entry) && (swp_offset(entry) & MEMCOMP_INCOMPRESSIBLE);
+}
+static inline bool folio_memcomp_reserved(struct folio *folio)
+{
+	swp_entry_t s = memcomp_folio_swap_get(folio);
+	return is_memcomp_entry(s) && !memcomp_entry_is_mark(s);
+}
+static inline bool folio_test_incompressible(struct folio *folio)
+{
+	return folio_test_anon(folio) && memcomp_entry_is_mark(memcomp_folio_swap_get(folio));
+}
+static inline void folio_set_incompressible(struct folio *folio, u32 hash)
+{
+	folio->private = (void *)make_memcomp_entry(MEMCOMP_INCOMPRESSIBLE | hash).val;
+}
+static inline u32 memcomp_folio_hash(struct folio *folio)
+{
+	void *src = kmap_local_folio(folio, 0);
+	u32 hash = xxh64(src, folio_size(folio), 0);
+	kunmap_local(src);
+	return hash;
+}
+static inline u32 folio_incompressible_hash(struct folio *folio)
+{
+	return (u32)swp_offset(memcomp_folio_swap_get(folio));
+}
+static inline void folio_clear_incompressible(struct folio *folio)
+{
+	folio->private = NULL;
+}
