+
+static int memcomp_objcg_charge(struct obj_cgroup *objcg, gfp_t gfp,
+				size_t size)
+{
+#if defined(CONFIG_MEMCG)
+	if (!objcg || !size)
+		return 0;
+
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	{
+		struct memcomp_kunit_objcg *model;
+		bool modeled = false;
+		int ret = 0;
+
+		rcu_read_lock();
+		model = rcu_dereference(memcomp_kunit_objcg);
+		if (model && objcg == &model->objcg) {
+			int call = atomic_inc_return(&model->charge_calls);
+
+			modeled = true;
+			if (call == model->fail_at)
+				ret = model->error;
+			else
+				atomic_long_add(size, &model->charged);
+		}
+		rcu_read_unlock();
+		if (modeled)
+			return ret;
+	}
+#endif
+	return obj_cgroup_charge(objcg, gfp, size);
+#else
+	return 0;
+#endif
+}
+
+static void memcomp_objcg_uncharge(struct obj_cgroup *objcg, size_t size)
+{
+#if defined(CONFIG_MEMCG)
+	if (!objcg || !size)
+		return;
+#ifdef CONFIG_MEMCOMP_KUNIT_TEST
+	{
+		struct memcomp_kunit_objcg *model;
+		bool modeled = false;
+
+		rcu_read_lock();
+		model = rcu_dereference(memcomp_kunit_objcg);
+		if (model && objcg == &model->objcg) {
+			atomic_inc(&model->uncharge_calls);
+			atomic_long_sub(size, &model->charged);
+			modeled = true;
+		}
+		rcu_read_unlock();
+		if (modeled)
+			return;
+	}
+#endif
+	obj_cgroup_uncharge(objcg, size);
+#endif
+}
